{
  "name": "corpus_dataset_source_stop",
  "version": "1.0.0",
  "description": "Corpus 数据集输入源算子。用于根据数据集唯一标识 ID 查询数据集详情，取出其中的 cstr，再获取下载地址集合、下载一个或多个数据集 tar 文件，并以 fileName 作为输出 key 提供给下游算子。该算子没有上游输入，必须作为 DAG 的起始节点使用。",
  "language": "python",
  "script_path": "scripts/run_corpus_dataset_source_stop.py",
  "entrypoint": "python scripts/run_corpus_dataset_source_stop.py",
  "input_params": [
    {
      "name": "dataset_id",
      "role": "data",
      "type": "string",
      "required": true,
      "description": "数据集唯一标识 ID"
    }
  ],
  "output_params": [
    {
      "name": "<fileName>",
      "role": "output_data",
      "type": "file_artifact",
      "default": "corpus_dataset_source_output",
      "description": "以 fileName 为输出 key 的本地文件引用，供下游算子使用"
    }
  ],
  "command_template": [
    "python",
    "{script_path}",
    "--dataset_id",
    "{dataset_id}",
    "--output_dir",
    "{output_dir}"
  ]
}
