{
  "name": "corpus_dataset_directory",
  "version": "1.0.0",
  "description": "数据集目录源节点。无上游 DAG 输入，通过 HTTP 调用数据集目录接口，获取目录根层或指定目录节点的下一层并输出 JSON 文件。",
  "language": "python",
  "script_path": "scripts/run_corpus_dataset_directory.py",
  "entrypoint": "python scripts/run_corpus_dataset_directory.py",
  "node_type": "source",
  "input_params": [
    {"name": "cstr", "role": "data", "type": "string", "required": true, "description": "数据集 CSTR 标识"},
    {"name": "file_id", "role": "data", "type": "string", "required": false, "description": "要展开的目录节点 fileId；不传时获取目录根层"}
  ],
  "output_params": [
    {"name": "output", "role": "output_data", "type": "json_file", "default": "corpus_dataset_directory_output.json", "description": "数据集目录结果文件"}
  ],
  "command_template": ["python", "{script_path}", "--cstr", "{cstr}", "--file_id", "{file_id}"],
  "tag": "数据集目录",
  "publisher": "COMMUNITY"
}
