{
  "name": "corpus_dataset_sample",
  "version": "1.0.0",
  "description": "语料采样源节点。无上游 DAG 输入，通过 HTTP 调用 Corpus 数据集随机采样接口并输出 JSON 文件。",
  "language": "python",
  "script_path": "scripts/run_corpus_dataset_sample.py",
  "entrypoint": "python scripts/run_corpus_dataset_sample.py",
  "node_type": "source",
  "input_params": [
    {"name": "cstr", "role": "data", "type": "string", "required": true, "description": "数据集 CSTR 标识"},
    {"name": "size", "role": "data", "type": "int", "required": false, "default": 5, "description": "随机采样条数"}
  ],
  "output_params": [
    {"name": "output", "role": "output_data", "type": "json_file", "default": "corpus_dataset_sample_output.json", "description": "语料采样结果文件"}
  ],
  "command_template": ["python", "{script_path}", "--cstr", "{cstr}", "--size", "{size}"],
  "tag": "语料采样",
  "publisher": "COMMUNITY"
}
